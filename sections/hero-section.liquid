<div class="max-w-6xl mx-auto my-8">

  <div class="flex flex-column items-center w-full my-3 relative">
    {% if section.settings.hero_image %}
      <img class="w-full h-80 md:h-96 object-cover object-center brightness-50 shadow-lg" src="{{ section.settings.hero_image | image_url: width: 1000 }}">

    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-100' }}
    {% endif %}
    <div class="flex flex-col justify-center items-center absolute object-center left-1/2 -translate-x-1/2  ">
      <h1 class="text-3xl my-2 text-white uppercase text-center">{{ section.settings.main_message }}</h1>
      <h2 class="text-xl my-2 text-white text-center">{{ section.settings.sub_message }}</h2>
      {% if section.settings.display_button %}
        <button class="w-full p-3 border border-white text-white font-medium hover:bg-white hover:text-black rounded-md">
          <a href="{{section.settings.button_link}}">{{ section.settings.button_name }}</a>
        </button>
      {% endif %}
    </div>

  </div>


</div>

{% schema %}
  {
    "name": "Hero Image",
    "settings": [
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Background Image"
      },
      {
        "type": "text",
        "id": "main_message",
        "label": "Main Message"
      },
      {
        "type": "text",
        "id": "sub_message",
        "label": "Sub Message"
      },
      {
        "type": "checkbox",
        "id": "display_button",
        "default": true,
        "label": "Display Button"
      }, {
        "type": "text",
        "id": "button_name",
        "label": "Button Message"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "presets": [
      {
        "name": "Hero Section"
      }
    ]

  }
{% endschema %}